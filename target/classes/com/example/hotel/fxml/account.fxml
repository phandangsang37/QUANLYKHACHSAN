<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane xmlns:fx="http://javafx.com/fxml"
    fx:controller="com.example.hotel.controller.AccountController"
    fitToWidth="true"
    style="-fx-background-color: #f4f7f7;">

    <content>
        <VBox spacing="18"
            style="-fx-background-color: #f4f7f7;">

            <padding>
                <Insets top="25" right="25"
                    bottom="25" left="25" />
            </padding>

            <Label text="Quản lý tài khoản"
                style="-fx-font-size: 26px;
                          -fx-font-weight: bold;
                          -fx-text-fill: #102D30;" />

            <Label text="Danh sách tài khoản"
                style="-fx-font-size: 18px;
                          -fx-font-weight: bold;" />

            <TableView fx:id="accountTable"
                prefHeight="280">

                <columns>
                    <TableColumn fx:id="userIdColumn"
                        text="ID" prefWidth="80" />

                    <TableColumn fx:id="usernameColumn"
                        text="Tên đăng nhập" prefWidth="220" />

                    <TableColumn fx:id="roleColumn"
                        text="Vai trò" prefWidth="160" />

                    <TableColumn fx:id="statusColumn"
                        text="Trạng thái" prefWidth="150" />
                </columns>

            </TableView>

            <Separator />

            <Label text="Tạo tài khoản mới"
                style="-fx-font-size: 18px;
                          -fx-font-weight: bold;" />

            <HBox spacing="10" alignment="CENTER_LEFT">

                <TextField fx:id="newUsernameField"
                    promptText="Tên đăng nhập"
                    prefWidth="170" />

                <PasswordField fx:id="newPasswordField"
                    promptText="Mật khẩu (ít nhất 12 ký tự)"
                    prefWidth="210" />

                <ComboBox fx:id="newRoleComboBox"
                    prefWidth="130" />

                <Button text="Tạo tài khoản"
                    onAction="#handleCreateAccount" />
            </HBox>

            <Separator />

            <Label text="Chỉnh sửa tài khoản đã chọn"
                style="-fx-font-size: 18px;
                          -fx-font-weight: bold;" />

            <Label fx:id="selectedAccountLabel"
                text="Chưa chọn tài khoản" />

            <HBox spacing="10" alignment="CENTER_LEFT">

                <ComboBox fx:id="selectedRoleComboBox"
                    prefWidth="150" />

                <Button fx:id="changeRoleButton"
                    text="Đổi quyền"
                    onAction="#handleChangeRole" />

                <Button fx:id="lockButton"
                    text="Khóa tài khoản"
                    onAction="#handleToggleLock" />
            </HBox>

            <HBox spacing="10" alignment="CENTER_LEFT">

                <PasswordField fx:id="resetPasswordField"
                    promptText="Mật khẩu mới (ít nhất 12 ký tự)"
                    prefWidth="270" />

                <Button fx:id="resetPasswordButton"
                    text="Đặt lại mật khẩu"
                    onAction="#handleResetPassword" />
            </HBox>

            <Label fx:id="messageLabel"
                wrapText="true" />

        </VBox>
    </content>

</ScrollPane>