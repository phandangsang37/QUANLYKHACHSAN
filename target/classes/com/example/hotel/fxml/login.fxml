<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
    xmlns:fx="http://javafx.com/fxml"
    fx:controller="com.example.hotel.controller.LoginController"
    alignment="CENTER"
    spacing="15">

    <Label text="HỆ THỐNG QUẢN LÝ KHÁCH SẠN" />
    <TextField
        fx:id="usernameField"
        promptText="Tên đăng nhập"
        maxWidth="300" />
    <PasswordField
        fx:id="passwordField"
        promptText="Mật khẩu"
        maxWidth="300" />
    <Button
        text="Đăng nhập"
        onAction="#handleLogin" />
    <Label
        fx:id="messageLabel" />

</VBox>