<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
    fx:controller="com.example.hotel.controller.CustomerController"
    spacing="16"
    style="-fx-background-color: #f4f7f7;">

    <padding>
        <Insets top="25" right="25" bottom="25" left="25" />
    </padding>

    <Label text="Quản lý khách hàng"
        style="-fx-font-size: 26px;
                  -fx-font-weight: bold;
                  -fx-text-fill: #102D30;" />

    <TextField fx:id="searchField"
        promptText="Tìm theo tên, số điện thoại hoặc email..."
        maxWidth="450" />

    <TableView fx:id="customerTable"
        prefHeight="350"
        VBox.vgrow="ALWAYS">

        <columns>
            <TableColumn fx:id="customerIdColumn"
                text="Mã KH" prefWidth="80" />

            <TableColumn fx:id="fullNameColumn"
                text="Họ và tên" prefWidth="190" />

            <TableColumn fx:id="phoneColumn"
                text="Số điện thoại" prefWidth="130" />

            <TableColumn fx:id="emailColumn"
                text="Email" prefWidth="220" />

            <TableColumn fx:id="addressColumn"
                text="Địa chỉ" prefWidth="250" />
        </columns>
    </TableView>

    <Label text="Thông tin khách hàng"
        style="-fx-font-size: 18px;
                  -fx-font-weight: bold;" />

    <GridPane hgap="12" vgap="12">
        <Label text="Họ tên:" GridPane.rowIndex="0" GridPane.columnIndex="0" />
        <TextField fx:id="fullNameField"
            promptText="Nhập họ tên"
            GridPane.rowIndex="0" GridPane.columnIndex="1" />

        <Label text="Số điện thoại:"
            GridPane.rowIndex="1" GridPane.columnIndex="0" />
        <TextField fx:id="phoneField"
            promptText="Nhập số điện thoại"
            GridPane.rowIndex="1" GridPane.columnIndex="1" />

        <Label text="Email:"
            GridPane.rowIndex="2" GridPane.columnIndex="0" />
        <TextField fx:id="emailField"
            promptText="Nhập email"
            GridPane.rowIndex="2" GridPane.columnIndex="1" />

        <Label text="Địa chỉ:"
            GridPane.rowIndex="3" GridPane.columnIndex="0" />
        <TextField fx:id="addressField"
            promptText="Nhập địa chỉ"
            GridPane.rowIndex="3" GridPane.columnIndex="1" />
    </GridPane>

    <HBox spacing="12">
        <Button text="Thêm khách hàng" onAction="#handleAddCustomer" />
        <Button text="Cập nhật" onAction="#handleUpdateCustomer" />
        <Button text="Xóa" onAction="#handleDeleteCustomer" />
        <Button text="Làm mới" onAction="#handleResetForm" />
        <Button text="Lịch sử đặt phòng"
            onAction="#handleBookingHistory" />
    </HBox>

    <Label fx:id="messageLabel" wrapText="true" />
</VBox>